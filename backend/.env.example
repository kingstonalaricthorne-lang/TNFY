# Copy this file to .env and fill in your values

NODE_ENV=development
PORT=5000

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tnyf_db?schema=public"

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT — single secret, min 32 chars. Refresh tokens are stored in Redis and
# delivered as httpOnly cookies (not signed JWTs).
JWT_SECRET=replace-with-a-strong-random-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=tnyf-product-images

SENDGRID_API_KEY=SG.replace-with-key
EMAIL_FROM=noreply@tnyf.com
EMAIL_FROM_NAME=TNYF

CLIENT_URL=http://localhost:3000
API_URL=http://localhost:5000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
